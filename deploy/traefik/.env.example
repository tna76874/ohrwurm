# ───────── Ohrwurm ─────────
# Öffentlicher Hostname (DNS muss auf den Traefik-Host zeigen)
OHRWURM_HOST=ohrwurm.example.org
# Image aus der GitHub-Pipeline (oder lokal mit `make image` gebaut: ohrwurm:dev)
OHRWURM_IMAGE=ghcr.io/tna76874/ohrwurm:latest

# ───────── Externer Identity Provider (OIDC) ─────────
# Client-Typ: öffentlich (public) mit PKCE, KEIN Client-Secret.
# Redirect-URI:      https://ohrwurm.example.org/
# Logout-Redirect:   https://ohrwurm.example.org/
# Web-Origin / CORS: https://ohrwurm.example.org
#
# Authentik (Provider „OAuth2/OpenID“, Client type „Public“; unter „Advanced
# protocol settings“ den Scope „offline_access“ zuweisen):
OIDC_ISSUER=https://auth.example.org/application/o/ohrwurm/
OIDC_CLIENT_ID=ohrwurm
OIDC_SCOPES=openid profile email offline_access
#
# Keycloak (Client: „Client authentication“ aus, Standard flow an,
# PKCE Method S256, Web origins „+“):
# OIDC_ISSUER=https://sso.example.org/realms/firma
# OIDC_CLIENT_ID=ohrwurm
# OIDC_SCOPES=openid profile email offline_access
#
# Microsoft Entra ID (App-Registrierung, Plattform „Single-page application“):
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<application-id>
# OIDC_SCOPES=openid profile email offline_access
#
# Nur wenn der Server den IdP intern unter anderer Adresse erreicht als die Browser:
# OIDC_INTERNAL_URL=http://authentik-server:9000/application/o/ohrwurm

# ───────── KI-Endpunkte ─────────
# Adressen, die Browser für den KI-Helfer nutzen dürfen (Leerzeichen-getrennt).
# localhost = KI-Programm auf dem eigenen Rechner (Ollama :11434, LM Studio :1234).
# Firmen-Endpunkte müssen per HTTPS erreichbar sein und CORS für OHRWURM_HOST erlauben.
LLM_ORIGINS=http://localhost:11434 http://127.0.0.1:11434 http://localhost:1234 http://127.0.0.1:1234 https://llm.example.org

# ───────── Traefik ─────────
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Nur für den optionalen, mitgelieferten Traefik (--profile traefik):
ACME_EMAIL=admin@example.org

# ───────── Sonstiges ─────────
# Sitzungen ohne verbundene Geräte vergisst der Server nach dieser Zeit
# (die Daten liegen ohnehin auf den Geräten).
SESSION_TTL=24h
# Modelle für `docker compose --profile setup run --rm models`
WHISPER_MODELS=onnx-community/whisper-base onnx-community/whisper-small
