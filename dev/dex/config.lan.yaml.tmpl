# Dex für Tests im lokalen Netz (make run-lan). __LAN_HOST__ wird vom Makefile ersetzt.
# Alle Dummy-Konten haben das Passwort: password
issuer: https://__LAN_HOST__:8443/dex

storage:
  type: memory

web:
  http: 0.0.0.0:5556

oauth2:
  skipApprovalScreen: true

expiry:
  idTokens: 1h

staticClients:
  - id: ohrwurm
    name: Ohrwurm
    public: true
    redirectURIs:
      - https://__LAN_HOST__:8443/

enablePasswordDB: true

